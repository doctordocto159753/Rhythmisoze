# ---------------------------------------------------------------------------
# Rhythmisoze environment. Copy to .env.local and fill in. No secrets in git.
# Browser-only development can show the UI and import MIDI. Audio transcription
# requires the configured server-side GAME service (compose supplies defaults).
# ---------------------------------------------------------------------------

# Public site origin, used for share links and OG image absolute URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Publishing: object storage (Vercel Blob) ------------------------------
# Server-side only. Without it, /api/publish/* returns a disabled state and the
# UI hides the publish action instead of failing at upload time.
BLOB_READ_WRITE_TOKEN=

# --- Publishing: PostgreSQL (Neon via Vercel Marketplace recommended) ------
# Server-side only.
DATABASE_URL=

# --- Optional: analytics sink ---------------------------------------------
# Leave empty to keep analytics in no-op mode. Never receives audio.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=

# --- Authoritative transcription -----------------------------------------
# Server-side only. There is no browser-model fallback.
# TRANSCRIPTION_ENABLED=true
# TRANSCRIPTION_API_URL=http://localhost:8083
# TRANSCRIPTION_REQUEST_TIMEOUT_MS=180000
# GAME_BACKEND=pytorch
# GAME_MODEL_TIER=small
# GAME_MODEL_VERSION=1.0.0
# GAME_RANDOM_SEED=0

# --- AI Musician (optional) ---
#
# Leave these unset and the product runs exactly as it did before: three
# versions, no outbound traffic beyond loading the app. The Musician area is not
# rendered at all, rather than shown disabled.
#
# Both are required together. Setting the flag without a URL counts as disabled,
# so a half-configured deployment fails closed rather than sending requests to a
# relative path that resolves back to this app.

# MUSICIAN_ENABLED=true

# Where the Musician service lives. SERVER-SIDE ONLY -- this is never sent to
# the browser. The client talks to /api/musician/*, which proxies to here, so
# the service can sit on a private network and needs no authentication of its
# own. Exposing this value would turn an internal service into a public
# inference endpoint.
# MUSICIAN_API_URL=http://localhost:8080

# How long a single generation may take before it is abandoned. Default 180000.
# MUSICIAN_REQUEST_TIMEOUT_MS=180000
