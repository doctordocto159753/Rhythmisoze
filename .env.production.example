# Rhythmisoze — self-hosted edition.
#
# Copy to .env and edit. ./scripts/bootstrap.sh does this for you and fills in
# fresh secrets.

# ---- required for production -------------------------------------------
# The public hostname. Caddy obtains a TLS certificate for exactly this name,
# so it must already point at this server.
SITE_DOMAIN=rhythmisoze.example.com
SITE_URL=https://rhythmisoze.example.com
ACME_EMAIL=you@example.com

# ---- secrets -----------------------------------------------------------
# Signs publish tickets. Changing it invalidates outstanding tickets, which is
# harmless; leaking it lets anyone write into your object store, which is not.
PUBLISH_SECRET=
# Guards the purge endpoint.
MAINTENANCE_TOKEN=
POSTGRES_PASSWORD=

# ---- storage -----------------------------------------------------------
# local-disk keeps published audio on a Docker volume: no cloud account, no
# egress bill. `vercel-blob` is the other driver and needs BLOB_READ_WRITE_TOKEN.
STORAGE_DRIVER=local-disk

# ---- AI Musician -------------------------------------------------------
MUSICIAN_ENABLED=true
# auto prefers a GPU when one exists and falls back to CPU. It never fails for
# want of CUDA.
MUSICIAN_DEVICE=auto
# real uses the published models; fake uses deterministic stand-ins and needs no
# weights, which is useful for working on the product without 1.4 GB present.
MUSICIAN_ADAPTERS=real
MUSICIAN_REQUEST_TIMEOUT_MS=180000
MUSICIAN_GENERATION_TIMEOUT_SEC=300
# How many jobs may wait before the service returns 503. One worker generates one
# job at a time, so a longer queue is a longer wait ending in a client timeout.
MUSICIAN_MAX_QUEUE_DEPTH=16
# Model workers are single-threaded per loaded weight copy. Raising these beyond
# the number of copies queues work inside the worker, where it is invisible.
MUSICIAN_MELODY_CONCURRENCY=1
MUSICIAN_RWKV_CONCURRENCY=1
MELODYT5_MEMORY_LIMIT=8g
RWKV_MEMORY_LIMIT=4g

# ---- authoritative transcription --------------------------------------
TRANSCRIPTION_ENABLED=true
TRANSCRIPTION_REQUEST_TIMEOUT_MS=180000
GAME_BACKEND=pytorch
GAME_MODEL_TIER=small
GAME_MODEL_VERSION=1.0.0
GAME_RANDOM_SEED=0

# ---- local only --------------------------------------------------------
WEB_PORT=3000
