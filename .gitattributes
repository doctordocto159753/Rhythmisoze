# Shell scripts are executed by bash, including inside Linux containers and in
# Git Bash on Windows. CRLF line endings make bash read a stray carriage return
# into every captured variable -- which surfaces as unrelated-looking failures
# such as curl reporting a malformed URL. Keep them LF on every platform.
*.sh text eol=lf

# PowerShell is the Windows counterpart and is happy either way; pin it too so
# the pair stays predictable.
*.ps1 text eol=crlf
