# Copy to .env and adjust. Every value here has a working default; this file
# exists to show what is tunable, not to be required.

# auto | cpu | cuda. `auto` prefers a GPU when one exists and falls back to CPU.
# It never fails because CUDA is absent.
MUSICIAN_DEVICE=auto

# Where the API is published. The workers are never published at all.
MUSICIAN_PORT=8080

# Where bootstrap.sh/.ps1 put the weights. Mounted read-only into the workers.
MUSICIAN_MODELS_DIR=../../models

# Model workers are single-threaded per loaded weight copy. Raising these beyond
# the number of copies queues work inside the worker, where it is invisible.
MUSICIAN_MELODY_CONCURRENCY=1
MUSICIAN_RWKV_CONCURRENCY=1

# A generation that has run this long is not going to finish usefully.
MUSICIAN_GENERATION_TIMEOUT_SEC=300

MELODYT5_MEMORY_LIMIT=6g
RWKV_MEMORY_LIMIT=3g

MUSICIAN_LOG_LEVEL=INFO

# Set to 1 only to debug a specific transcription. Note data is the user's
# music; it is not logged by default.
# MUSICIAN_LOG_NOTES=0
